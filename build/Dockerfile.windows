# Windows builder: freezes main.py with the full python.org Windows Python (includes Tk) under Wine.
FROM debian:trixie-slim
ARG WIN_PYTHON_VERSION=3.12.10
ENV DEBIAN_FRONTEND=noninteractive \
    WINEPREFIX=/opt/wine WINEARCH=win64 WINEDEBUG=-all WINEDLLOVERRIDES="mscoree,mshtml="
RUN dpkg --add-architecture i386 \
 && apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl wget unzip gnupg xvfb xauth \
 && mkdir -pm755 /etc/apt/keyrings \
 && wget -qO /etc/apt/keyrings/winehq-archive.key https://dl.winehq.org/wine-builds/winehq.key \
 && wget -qNP /etc/apt/sources.list.d/ https://dl.winehq.org/wine-builds/debian/dists/trixie/winehq-trixie.sources \
 && apt-get update \
 && apt-get install -y --install-recommends winehq-stable \
 && rm -rf /var/lib/apt/lists/*
# Full python.org installer (the NuGet/embeddable builds have no Tcl/Tk, so tkinter would be missing).
RUN wineboot --init && wineserver -w \
 && curl -sSLo /tmp/python-installer.exe "https://www.python.org/ftp/python/${WIN_PYTHON_VERSION}/python-${WIN_PYTHON_VERSION}-amd64.exe" \
 && (xvfb-run -a wine /tmp/python-installer.exe /quiet InstallAllUsers=0 TargetDir='C:\Python312' \
      Include_tcltk=1 Include_pip=1 Include_test=0 Include_doc=0 Include_launcher=0 \
      PrependPath=0 Shortcuts=0 AssociateFiles=0 || true) \
 && wineserver -w \
 && rm -f /tmp/python-installer.exe \
 && wine 'C:\Python312\python.exe' -c "import tkinter, sys; print('tkinter', tkinter.TkVersion, sys.version)" \
 && wine 'C:\Python312\python.exe' -m pip install -q --upgrade pip \
 && wineserver -w
WORKDIR /src
CMD ["bash", "/src/build/build-windows.sh"]
